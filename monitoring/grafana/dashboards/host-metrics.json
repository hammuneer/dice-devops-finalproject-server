      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_filesystem_size_bytes{job=\"node\",mountpoint=\"/\"} - node_filesystem_avail_bytes{job=\"node\",mountpoint=\"/\"}",
