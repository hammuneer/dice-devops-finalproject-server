    {
      "id": 27,
      "type": "table",
      "title": "Containers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "sum by (name, image) (container_memory_working_set_bytes{job=\"cadvisor\",name!=\"\"}) and on (name, image) (max by (name, image) (container_last_seen{job=\"cadvisor\",name!=\"\"}) > time() - 120)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "100 * sum by (name, image) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\"}[2m])) and on (name, image) (max by (name, image) (container_last_seen{job=\"cadvisor\",name!=\"\"}) > time() - 120)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "max by (name, image) (time() - container_start_time_seconds{job=\"cadvisor\",name!=\"\"}) and on (name, image) (max by (name, image) (container_last_seen{job=\"cadvisor\",name!=\"\"}) > time() - 120)"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "Container",
              "image": "Image",
              "Value #A": "Memory",
              "Value #B": "CPU %",
              "Value #C": "Uptime"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Memory",
            "desc": true
          }
        ]
      }
    }
  ]
